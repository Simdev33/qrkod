# OPTIONAL. On Vercel the QR codes automatically get the project's production domain (the custom domain,
# e.g. generatemyqrcodes.com, if there is one, otherwise *.vercel.app). Only set this to override it.
# NEXT_PUBLIC_SITE_URL=https://generatemyqrcodes.com

# Turso database (https://app.turso.tech). If empty, the local data/kockakod.db file is used; required on Vercel.
# The tables are created automatically on the first request.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Any long random string: used to hash IP addresses for the code-creation limit.
CREATOR_SALT=

# Stripe (the TourCierge account shared with GetProCV, DoneSignIn, ConvertPDFNow – everything of this site is
# tagged metadata.app = "generatemyqrcodes"). Without a key: demo activation in development, payments off in
# production. The product and the two prices (€1 intro fee, €3.99/month) are created on first use.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Optional: without a webhook, payments are recorded right after checkout, and renewals / endings are read
# from Stripe when a code's paid period has passed. With one, changes show up immediately.
# Webhook endpoint: https://generatemyqrcodes.com/api/stripe/webhook
# Events: checkout.session.completed, customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...

# Signing in on the "My codes" page with a 6-digit email code (subscribers see their codes on any device).
# SESSION_SECRET: any long random string (at least 16 characters) – it signs the sign-in cookies.
SESSION_SECRET=
# Resend (https://resend.com): API key, and the sender address on a domain verified in Resend.
# Without a key, in development the code is printed to the server log; in production signing in is off.
RESEND_API_KEY=re_...
EMAIL_FROM=GenerateMyQRCodes <no-reply@generatemyqrcodes.com>

# Optional: existing price IDs instead of the automatically created ones (own names, so the STRIPE_PRICE_*
# values of GetProCV / DoneSignIn / ConvertPDFNow are never picked up by mistake).
# GMQR_PRICE_INTRO=price_...
# GMQR_PRICE_MONTHLY=price_...

# Local only: folder of the SQLite file (default: ./data)
# DATA_DIR=
