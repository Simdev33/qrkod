# NEM KÖTELEZŐ. Vercelen a QR-kódok magától a projekt éles domainjét kapják (saját domain esetén azt,
# különben a *.vercel.app címet). Csak akkor add meg, ha ettől eltérő címet szeretnél a kódokba.
# NEXT_PUBLIC_SITE_URL=https://kockakod.hu

# Turso adatbázis (https://app.turso.tech). Ha üres, helyben a data/kockakod.db fájlt használja;
# Vercelen kötelező. A táblák az első kéréskor automatikusan létrejönnek.
TURSO_DATABASE_URL=libsql://kockakod-felhasznalonev.turso.io
TURSO_AUTH_TOKEN=

# Stripe (https://dashboard.stripe.com/apikeys). Kulcs nélkül fejlesztéskor demó fizetés fut,
# élesben (NODE_ENV=production) kulcs nélkül az előfizetés ki van kapcsolva.
STRIPE_SECRET_KEY=sk_test_...

# Webhook-végpont: https://kockakod.hu/api/stripe/webhook
# Események: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...

# Tetszőleges hosszú, véletlen szöveg: ezzel hash-eljük az IP-címet a kódgyártási korláthoz.
CREATOR_SALT=

# Csak helyi futtatáshoz: az SQLite-fájl mappája (alapértelmezés: ./data)
# DATA_DIR=
